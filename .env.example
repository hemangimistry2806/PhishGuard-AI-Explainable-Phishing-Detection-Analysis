# ==============================================================================
# PhishGuard-AI — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Database URL for persistent SQLite storage
# In Docker, this points to the mounted volume at /app/data/phishguard.db
# In local development without Docker: sqlite:///backend/phishguard.db
DATABASE_URL=sqlite:////app/data/phishguard.db

# Path to trained XGBoost production model
MODEL_PATH=/app/ml/models/xgboost_model.pkl

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# LLM Explainability Service (Optional)
# If provided, enables AI-generated plain-English narrative alongside SHAP.
# If omitted, PhishGuard-AI falls back seamlessly to rule-based evidence synthesis.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Auditor / Reviewer Authentication
# Used to authenticate reviewer endpoints (e.g. PATCH /feedback/{id}/review)
# ------------------------------------------------------------------------------
REVIEWER_API_KEY=auditor-secret-key-2026

# ------------------------------------------------------------------------------
# Frontend Configuration
# Leave empty ("") when using Docker Nginx reverse-proxy on port 5173.
# In local development without Docker, set to http://127.0.0.1:8000 if needed.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
